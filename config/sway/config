# =========================
#  Sway config
#  Wispie-chan edition 💜
#  Noctalia V5 + Rio BLZ
# =========================

# Modificateur
set $mod Super

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Autostart : Noctalia V5 + curseur + services
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Lancer Noctalia V5 (daemon)
exec --no-startup-id noctalia

# Curseur Rio BLZ
exec --no-startup-id gsettings set org.gnome.desktop.interface cursor-theme "remielle_black"
exec --no-startup-id gsettings set org.gnome.desktop.interface cursor-size 24

# Polkit (lxqt-policykit-agent ou polkit-gnome-authentication-agent-1)
exec --no-startup-id lxqt-policykit-agent &

# Clipboard history
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Screenshot (grimshot)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bindsym Print       exec grimshot save output ~/Images/Screenshots/screenshot_%Y%m%d_%H%M%S.png
bindsym Shift+Print exec grimshot save area   ~/Images/Screenshots/screenshot_%Y%m%d_%H%M%S.png
bindsym Ctrl+Print  exec grimshot save window ~/Images/Screenshots/screenshot_%Y%m%d_%H%M%S.png

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Noctalia V5 IPC
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Win+Space : launcher
bindsym $mod+space exec noctalia msg panel-toggle launcher

# Win+O : settings
bindsym $mod+o exec noctalia msg settings-toggle

# Win+V : clipboard manager
bindsym $mod+v exec rofi -show clipboard -modi "clipboard:cliphist list" -clipboard -window-position br

# Win+N : Noctalia notes
bindsym $mod+n exec noctalia msg panel-toggle noctalia/notes:panel

# Win+Shift+W : wallpaper selector
bindsym $mod+Shift+w exec noctalia msg panel-toggle wallpaper

# Win+E : control center
bindsym $mod+e exec noctalia msg panel-toggle control-center

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GESTION DES FENÊTRES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PROGRAMMES & FENÊTRE (ports des raccourcis mango/hyprland)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bindsym $mod+t      exec kitty || alacritty || ghostty || foot
bindsym $mod+Return exec kitty || alacritty || ghostty || foot
bindsym $mod+q      kill
bindsym $mod+m      exec swaymsg exit
bindsym $mod+Tab    focus next

# Focus : flèches + vim (h j k l)
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+h     focus left
bindsym $mod+j     focus down
bindsym $mod+k     focus up
bindsym $mod+l     focus right

# Déplacer la fenêtre : Shift + flèches / h j k l
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h     move left
bindsym $mod+Shift+j     move down
bindsym $mod+Shift+k     move up
bindsym $mod+Shift+l     move right

# Changer d'écran focus (Win+Shift+A / D, comme mango)
bindsym $mod+Shift+a focus output left
bindsym $mod+Shift+d focus output right

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WORKSPACES (Win+1..0 : afficher, Win+Shift+1..0 : déplacer)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+F11       fullscreen toggle
bindsym $mod+Shift+f   floating toggle
bindsym $mod+b         splith
# bindsym $mod+v         splitv
bindsym $mod+s         layout stacking
bindsym $mod+w         layout tabbed
bindsym $mod+x         layout toggle split

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MODE RESIZE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

mode "resize" {
    bindsym Left  resize shrink width  20px
    bindsym Right resize grow   width  20px
    bindsym Up    resize shrink height 20px
    bindsym Down  resize grow   height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RÈGLES FENÊTRES FLOTTANTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

for_window [window_role="dialog"]        floating enable
for_window [window_role="pop-up"]        floating enable
for_window [window_type="dialog"]        floating enable
for_window [window_type="utility"]       floating enable
for_window [window_type="notification"]  floating enable, border none
for_window [app_id="noctalia-options"]   floating enable
for_window [app_id="noctalia-launcher"]  floating enable, border none

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENTRÉES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

input "type:keyboard" {
    xkb_layout ch
    xkb_variant fr
    repeat_delay 250
    repeat_rate 40
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}


#━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RECHARGEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INCLUDE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

include ~/.config/sway/config.d/*

include ~/.config/sway/monitors.conf

include ~/.config/sway/noctalia


