{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Software-only profile: no hardware lines (CPU, GPU, memory, disk).
  // Run with: fastfetch -c software
  "logo": {
    "type": "none"
  },
  "display": {
    "key": {
      "type": "both"
    },
    "separator": "⁣"
  },
  "modules": [
    { "type": "users", "key": "user" },
    { "type": "command", "key": "hname", "text": "hostname" },
    { "type": "uptime", "key": "uptime" },
    { "type": "os", "key": "distro" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "command", "key": "shell", "text": "printf '%s %s' \"${SHELL##*/}\" \"$(\"$SHELL\" --version 2>/dev/null | grep -oE '[0-9]+(\\.[0-9]+)+' | head -n1)\"" },
    "break",
    { "type": "packages", "key": "packages" },
    { "type": "locale", "key": "locale" },
    { "type": "theme", "key": "theme" },
    { "type": "icons", "key": "icons" },
    "break",
    "separator",
    "colors"
  ]
}
