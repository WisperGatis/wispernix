{
  "manifest_version": 3,
  "name": "Web Palette",
  "version": "0.1.0",
  "description": "Recolors website backgrounds to follow the Noctalia / Matugen palette.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["mapping.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
